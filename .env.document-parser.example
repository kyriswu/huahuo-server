# Merge these settings into the backend environment; this file contains no credentials.
# VPC test-environment example. The application's default remains disabled.
# General document parser: user-selected CPU ECS (64 vCPU / 128 GiB).
# disabled | ecs | always-on. Do not probe this private endpoint from the local host.
DOCUMENT_PARSER_MODE=ecs
DOCUMENT_PARSER_BASE_URL=http://172.18.102.103:8000
DOCUMENT_PARSER_HEALTH_PATH=/health
DOCUMENT_PARSER_API_TOKEN=
DOCUMENT_PARSER_ECS_REGION_ID=cn-beijing
DOCUMENT_PARSER_ECS_INSTANCE_ID=i-2zejbbo2svjieb44tqy8
DOCUMENT_PARSER_ECS_PRIVATE_IP=172.18.102.103
DOCUMENT_PARSER_IDLE_SECONDS=60
DOCUMENT_PARSER_CONCURRENCY=1
DOCUMENT_PARSER_MAX_PENDING=128
DOCUMENT_PARSER_STARTUP_TIMEOUT_SECONDS=600
DOCUMENT_PARSER_QUEUE_TIMEOUT_SECONDS=3600
DOCUMENT_PARSER_LEASE_MS=30000
DOCUMENT_PARSER_DEDUP_TTL_SECONDS=86400
# Optional: only an explicit ECS StartInstance OperationDenied.NoStock enables this fallback.
# Requires a single-A10 PostPaid/NoSpot ECS already Stopped + StopCharging in this VPC.
# ECI uses NoSpot (pay-as-you-go), never spot bidding or a public IP.
# This A10 fallback does not apply to the current CPU parser; keep it disabled.
DOCUMENT_PARSER_ECI_FALLBACK_ENABLED=false
DOCUMENT_PARSER_ECI_VPC_ID=vpc-2zervqxqgm7a38ryqkzm9
DOCUMENT_PARSER_ECI_SECURITY_GROUP_ID=sg-2zehm6137r0qv3bvdq3k
DOCUMENT_PARSER_ECI_VSWITCH_IDS=vsw-2zely72k5a1ag7l7co9ps,vsw-2zey0qgsjb583fdfqdtfj,vsw-2zesh4yhhyi6rryjcwxo8,vsw-2zejabzle8p9mbqjwqwp0
DOCUMENT_PARSER_ECI_INSTANCE_TYPES=ecs.gn7i-c8g1.2xlarge,ecs.gn7i-c16g1.4xlarge,ecs.gn7i-c32g1.8xlarge,ecs.gn7i-c48g1.12xlarge
# cuda-a10-native-first-oss-kbxml-v1-prod-callback; ECS must use the same new async protocol.
DOCUMENT_PARSER_ECI_IMAGE=huahuo-docker-hub-registry-vpc.cn-beijing.cr.aliyuncs.com/ai_service/xberg@sha256:152b65be33a26cfbe0a0dc24f2aea399965bf85b98bd97b2016aced02131a6c7
DOCUMENT_PARSER_ECI_ACR_INSTANCE_ID=cri-exln14fep34d4gic
# Extra temporary storage, in addition to the default 30 GiB. Shared memory is 1 GiB.
DOCUMENT_PARSER_ECI_EXTRA_STORAGE_GIB=40
# Reuses STORAGE_ALIYUN_OSS_BUCKET and <STORAGE_ALIYUN_OSS_KEY_PREFIX>/resources,
# with region-local internal OSS endpoint and canonical ALIYUN_RAM_* credentials.
# API concurrency 16; the machine semaphore above still controls global document concurrency.
# Enable only after supplying the CPU service's complete extraction configuration.
# The existing kbxml-request.json is the GPU/CUDA baseline, not a CPU preset.
DOCUMENT_EXTRACTION_MODE=disabled
DOCUMENT_EXTRACTION_CONFIG_PATH=resources/document-extraction/kbxml-request.json
DOCUMENT_EXTRACTION_POLL_MS=2000
DOCUMENT_EXTRACTION_MAX_RESPONSE_BYTES=67108864
# Set DOCUMENT_PARSER_MODE=ecs together with DOCUMENT_EXTRACTION_MODE=async.
# ECS uses existing ALIYUN_RAM_ACCESS_KEY_ID / ALIYUN_RAM_ACCESS_KEY_SECRET,
# with optional ALIYUN_RAM_SECURITY_TOKEN; always-on needs no cloud credentials.
# For a permanent API: set MODE=always-on, BASE_URL to the trusted configured URL,
# and HEALTH_PATH to its readiness path (or empty if it has no readiness API).
