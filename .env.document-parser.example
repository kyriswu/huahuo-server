# Merge these settings into the backend environment; this file contains no credentials.
# VPC test-environment example. The application's default remains disabled.
# disabled | ecs | always-on. Do not probe this private endpoint from the local host.
DOCUMENT_PARSER_MODE=ecs
DOCUMENT_PARSER_BASE_URL=http://172.18.102.101:8000
DOCUMENT_PARSER_HEALTH_PATH=/health
DOCUMENT_PARSER_API_TOKEN=
DOCUMENT_PARSER_ECS_REGION_ID=cn-beijing
DOCUMENT_PARSER_ECS_INSTANCE_ID=i-2zegwjwejyvpxoluhyx8
DOCUMENT_PARSER_ECS_PRIVATE_IP=172.18.102.101
DOCUMENT_PARSER_IDLE_SECONDS=60
DOCUMENT_PARSER_CONCURRENCY=1
DOCUMENT_PARSER_MAX_PENDING=128
DOCUMENT_PARSER_STARTUP_TIMEOUT_SECONDS=600
DOCUMENT_PARSER_QUEUE_TIMEOUT_SECONDS=3600
DOCUMENT_PARSER_LEASE_MS=30000
DOCUMENT_PARSER_DEDUP_TTL_SECONDS=86400
# Enable the existing file-ingestion pipeline in the VPC test environment:
DOCUMENT_EXTRACTION_MODE=async
DOCUMENT_EXTRACTION_CONFIG_PATH=resources/document-extraction/kbxml-request.json
DOCUMENT_EXTRACTION_POLL_MS=2000
DOCUMENT_EXTRACTION_MAX_RESPONSE_BYTES=67108864
# Set DOCUMENT_PARSER_MODE=ecs together with DOCUMENT_EXTRACTION_MODE=async.
# ECS uses existing ALIYUN_RAM_ACCESS_KEY_ID / ALIYUN_RAM_ACCESS_KEY_SECRET,
# with optional ALIYUN_RAM_SECURITY_TOKEN; always-on needs no cloud credentials.
# For a permanent API: set MODE=always-on, BASE_URL to the trusted configured URL,
# and HEALTH_PATH to its readiness path (or empty if it has no readiness API).
