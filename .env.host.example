# Optional host debugging; use the Volta-pinned Node 26.11.0 and pnpm 10.15.1.
# PG/Redis are not published by default.
# Names follow the root .env groups. This file is a deliberately small host-side subset.
APP_ENV=development
ALLOW_MOCK_PROVIDERS=true
SERVICE_ROLE=api-server

# 基础数据库和 Redis
DATABASE_URL=postgresql://huahuo_api:replace@127.0.0.1:15432/huahuo
REDIS_CACHE_URL=redis://127.0.0.1:16379/0
REDIS_QUEUE_URL=redis://127.0.0.1:16379/1
DATABASE_SSL_MODE=disable
DB_SCHEMA_MIN_VERSION=1

# HTTP
APP_TOKEN_SECRET=replace_with_at_least_32_random_characters
APP_JWT_ISSUER=huahuo-server
APP_JWT_AUDIENCE=huahuo-server,huahuo-agent
APP_JWT_SERVER_AUDIENCE=huahuo-server
APP_JWT_KEY_ID=server-current
APP_ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_SECONDS=2592000
APP_JWT_PRIVATE_KEY=
APP_JWT_PUBLIC_KEY=
APP_JWT_PREVIOUS_PUBLIC_KEY=
APP_JWT_PREVIOUS_KEY_ID=
# Generate two different values; each direction has its own key.
HUAHUO_SERVER_TO_AGENT_API_KEY=
HUAHUO_AGENT_TO_SERVER_API_KEY=
APP_PUBLIC_BASE_URL=http://127.0.0.1:3000
HOST=127.0.0.1
PORT=3000

# 全局对象存储（按需启用）
STORAGE_DRIVER=local
STORAGE_LOCAL_ROOT=./var/storage
STORAGE_ALIYUN_OSS_REGION=cn-beijing
STORAGE_ALIYUN_OSS_ENDPOINT=https://oss-cn-beijing.aliyuncs.com
STORAGE_ALIYUN_OSS_BUCKET=
STORAGE_ALIYUN_OSS_ACCESS_KEY_ID=
STORAGE_ALIYUN_OSS_ACCESS_KEY_SECRET=
STORAGE_ALIYUN_OSS_SECURE=true
STORAGE_ALIYUN_OSS_TIMEOUT_MS=120000
STORAGE_ALIYUN_OSS_KEY_PREFIX=huahuo

# 全局唯一 Milvus（按需启用）
MILVUS_ADDRESS=
MILVUS_USERNAME=
MILVUS_PASSWORD=
MILVUS_DATABASE=default
MILVUS_COLLECTION=huahuo_chunks
MILVUS_TLS=true
MILVUS_CREATE_IF_MISSING=true
MILVUS_SEARCH_CONCURRENCY=2

# RAG 入库生命周期（API 主机通常只创建任务，Worker 执行处理）
RAG_DENSE_CANDIDATES=20
RAG_BM25_CANDIDATES=20
RAG_HYBRID_CANDIDATES=30
RAG_RRF_K=60
RAG_INGESTION_ENABLED=true
RAG_PROVIDER_MODE=disabled
RAG_SOURCE_ALLOWED_HOSTS=
RAG_DOWNLOAD_TIMEOUT_MS=120000
RAG_MINERU_BASE_URL=https://mineru.net
RAG_MINERU_MODEL=vlm
RAG_MINERU_POLL_INTERVAL_MS=2000
RAG_MINERU_TIMEOUT_MS=900000
RAG_MINERU_TOKEN=
RAG_EMBEDDING_BASE_URL=https://api.siliconflow.cn/v1
RAG_EMBEDDING_API_KEY=
RAG_EMBEDDING_MODEL=Qwen/Qwen3-Embedding-8B
RAG_EMBEDDING_DIMENSIONS=4096
RAG_EMBEDDING_PROFILE=qwen3-embedding-8b-4096
RAG_INDEX_BUILD_ID=qwen3-embedding-8b-4096
RAG_RERANK_PROVIDER=disabled
RAG_RERANK_BASE_URL=https://api.siliconflow.cn/v1
RAG_RERANK_API_KEY=
RAG_RERANK_MODEL=Qwen/Qwen3-Reranker-8B
RAG_EMBEDDING_SEND_DIMENSIONS=false
RAG_EMBEDDING_TIMEOUT_MS=30000
RAG_EMBEDDING_MAX_RETRIES=2
RAG_INGEST_BATCH_SIZE=32
RAG_MAX_SOURCE_BYTES=209715200
RAG_PLAIN_TEXT_MAX_CHARS=50000
RAG_CHILD_TARGET_TOKENS=500
RAG_CHILD_MAX_TOKENS=800
RAG_CHILD_OVERLAP_TOKENS=64

# Model tokenizer files are provisioned locally; no model or tokenizer download at request time.
RAG_TOKENIZER_PATH=.local/tokenizers/qwen3-embedding-8b/tokenizer.json
RAG_TOKENIZER_CONFIG_PATH=.local/tokenizers/qwen3-embedding-8b/tokenizer_config.json
RAG_TOKENIZER_MAX_INPUT_TOKENS=32768
MANUAL_TEXT_ENABLED=false
MANUAL_TEXT_MILVUS_DATABASE=default
MANUAL_TEXT_MILVUS_COLLECTION=huahuo_manual_text
MANUAL_TEXT_TARGET_TOKENS=500
MANUAL_TEXT_MAX_EMBEDDING_TOKENS=800
MANUAL_TEXT_OVERLAP_TOKENS=64
RAG_INDEX_CONCURRENCY=2

# gRPC 传输代理；直连时留空。Compose 访问本机代理用 host.docker.internal，宿主机用 127.0.0.1。
grpc_proxy=
