# Optional host debugging; Node 24/pnpm required. PG/Redis are not published by default.
APP_ENV=development
SERVICE_ROLE=api-server
DATABASE_URL=postgresql://huahuo_api:replace@127.0.0.1:15432/huahuo
REDIS_CACHE_URL=redis://127.0.0.1:16379/0
REDIS_QUEUE_URL=redis://127.0.0.1:16379/1
DATABASE_SSL_MODE=disable
APP_TOKEN_SECRET=replace_with_at_least_32_random_characters
APP_PUBLIC_BASE_URL=http://127.0.0.1:3000
HOST=127.0.0.1
PORT=3000
