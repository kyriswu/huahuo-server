# 宿主进程调试配置；使用项目锁定的 Node 和 pnpm。

# 运行与容器
APP_ENV=development
ALLOW_MOCK_PROVIDERS=true
SERVICE_ROLE=api-server

# HTTP 与服务地址
# 仅信任受控入口；业务监听保持受限。
APP_PUBLIC_BASE_URL=http://127.0.0.1:3000
HOST=127.0.0.1
PORT=3000
HTTP_TRUST_PROXY_HOPS=0
API_SERVICE_BASE_URL=
# API_SERVICE_BASE_URL 供其他服务及解析回调访问；留空沿用 APP_PUBLIC_BASE_URL。

# PostgreSQL
DATABASE_URL=postgresql://huahuo_api:replace@127.0.0.1:15432/huahuo
DATABASE_SSL_MODE=disable
DB_SCHEMA_MIN_VERSION=1

# Redis
REDIS_CACHE_URL=redis://127.0.0.1:16379/0
REDIS_QUEUE_URL=redis://127.0.0.1:16379/1

# 用户与管理认证
APP_TOKEN_SECRET=replace_with_at_least_32_random_characters
APP_JWT_ISSUER=huahuo-server
APP_JWT_AUDIENCE=huahuo-server,huahuo-agent
APP_JWT_SERVER_AUDIENCE=huahuo-server
APP_JWT_KEY_ID=server-current
APP_ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_SECONDS=2592000
APP_JWT_PRIVATE_KEY=
APP_JWT_PUBLIC_KEY=
APP_JWT_PREVIOUS_PUBLIC_KEY=
APP_JWT_PREVIOUS_KEY_ID=

# Studio
# 仅开发或测试环境按需启用。
HUAHUO_STUDIO_AUTH_ENABLED=false
HUAHUO_STUDIO_ORIGIN=
HUAHUO_AGENT_PUBLIC_PATH=/agent

# 阿里云 RAM
ALIYUN_RAM_ACCESS_KEY_ID=
ALIYUN_RAM_ACCESS_KEY_SECRET=

# 对象存储
STORAGE_DRIVER=local
STORAGE_LOCAL_ROOT=./var/storage
STORAGE_ALIYUN_OSS_REGION=cn-beijing
STORAGE_ALIYUN_OSS_ENDPOINT=https://oss-cn-beijing.aliyuncs.com
STORAGE_ALIYUN_OSS_BUCKET=
STORAGE_ALIYUN_OSS_SECURE=true
STORAGE_ALIYUN_OSS_TIMEOUT_MS=120000
STORAGE_ALIYUN_OSS_KEY_PREFIX=huahuo

# Milvus
MILVUS_ADDRESS=
MILVUS_USERNAME=
MILVUS_PASSWORD=
MILVUS_DATABASE=default
MILVUS_TLS=true
MILVUS_CREATE_IF_MISSING=true

# RAG 模型连接
# 本机使用北京公网地址。
RAG_PROVIDER_MODE=disabled
RAG_SOURCE_ALLOWED_HOSTS=
RAG_EMBEDDING_BASE_URL=https://ws-example.cn-beijing.maas.aliyuncs.com/api/v1
RAG_EMBEDDING_API_KEY=
RAG_EMBEDDING_MODEL=qwen3.7-text-embedding-flash
RAG_EMBEDDING_DIMENSIONS=1024
RAG_EMBEDDING_PROFILE=qwen3.7-text-embedding-flash-1024-fp16
RAG_RERANK_PROVIDER=disabled
RAG_RERANK_BASE_URL=https://ws-example.cn-beijing.maas.aliyuncs.com/api/v1
RAG_RERANK_API_KEY=
RAG_RERANK_MODEL=qwen3.7-text-rerank

# gRPC 代理
# 直连时留空。
grpc_proxy=

# 知识索引集合
KB_NOTE_HYBRID_COLLECTION=huahuo_kb_note_hybrid_chunks
KB_DOCUMENT_KEYWORD_COLLECTION=huahuo_kb_keyword_chunks

# 短信
SMS_ALIYUN_REGION_ID=cn-hangzhou
SMS_ALIYUN_SIGN_NAME=
SMS_ALIYUN_TEMPLATE_CODE=
SMS_ALIYUN_CODE_PARAM=code
SMS_ALIYUN_CONNECT_TIMEOUT_MS=3000
SMS_ALIYUN_READ_TIMEOUT_MS=3000

# 指标
METRICS_ENABLED=true
METRICS_HOST=127.0.0.1
METRICS_SERVICE=huahuo-server

# 统一观测：留空时仅本地关联与指标，不向外发送 Trace。
# 发布时可将 OTEL_SERVICE_VERSION 设置为已审 Git SHA；留空使用包版本。
OTEL_SERVICE_VERSION=
# 完整 OTLP HTTP Trace 接收地址，例如 http://<内网collector>:4318/v1/traces。
OTEL_EXPORTER_OTLP_TRACES_ENDPOINT=
