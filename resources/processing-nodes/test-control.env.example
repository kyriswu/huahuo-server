# Merge into the existing test deployment environment; retain its other settings and credentials.
# Recreate api-server, admin, worker and scheduler with the same environment snapshot.
# Cloud control works over the Alibaba Cloud API; parser calls require a reachable VPC API.
APP_ENV=test
PROCESSING_NODES_CLOUD_CONTROL_ENABLED=true
# Keep PROCESSING_NODES_ENABLED unchanged; private API access is a separate choice.
