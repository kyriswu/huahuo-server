
# Compose and runtime
# 仅部署/服务配置；业务参数、RAG调参和处理节点在 Admin「运行配置」。
COMPOSE_PROJECT_NAME=huahuo-server-cloud-validation
COMPOSE_PROFILES=
APP_ENV=test
PROCESSING_NODES_CLOUD_CONTROL_ENABLED=true
PROCESSING_NODES_ENABLED=true
NODE_IMAGE=node:26.12.1-bookworm-slim
PNPM_VERSION=10.15.1
POSTGRES_IMAGE=postgres:17.9-bookworm
REDIS_IMAGE=redis:7.4.8-bookworm
BACKEND_IMAGE=huahuo-server:p02

# PostgreSQL: one instance with role credentials
POSTGRES_BOOTSTRAP_PASSWORD=<GENERATED_BOOTSTRAP>
POSTGRES_MIGRATOR_PASSWORD=<GENERATED_MIGRATOR>
POSTGRES_API_PASSWORD=<GENERATED_API_DB>
POSTGRES_ADMIN_PASSWORD=<GENERATED_ADMIN_DB>
POSTGRES_WORKER_PASSWORD=<GENERATED_WORKER_DB>
POSTGRES_SCHEDULER_PASSWORD=<GENERATED_SCHEDULER_DB>
DATABASE_MIGRATION_URL=postgresql://huahuo_migrator:<GENERATED_MIGRATOR>@pg.example.invalid:5432/huahuo
DATABASE_API_URL=postgresql://huahuo_api:<GENERATED_API_DB>@pg.example.invalid:5432/huahuo
DATABASE_ADMIN_URL=postgresql://huahuo_admin:<GENERATED_ADMIN_DB>@pg.example.invalid:5432/huahuo
DATABASE_WORKER_URL=postgresql://huahuo_worker:<GENERATED_WORKER_DB>@pg.example.invalid:5432/huahuo
DATABASE_SCHEDULER_URL=postgresql://huahuo_scheduler:<GENERATED_SCHEDULER_DB>@pg.example.invalid:5432/huahuo
DATABASE_URL=
DATABASE_SSL_MODE=verify-full
DATABASE_SSL_CA_FILE=
DATABASE_POOL_MAX_API=10
DATABASE_POOL_MAX_ADMIN=5
DATABASE_POOL_MAX_WORKER=10
DATABASE_POOL_MAX_SCHEDULER=3
DB_SCHEMA_MIN_VERSION=1

# Redis: one instance with cache and queue databases
REDIS_CACHE_URL=redis://redis:6379/0
REDIS_QUEUE_URL=redis://redis:6379/1
REDIS_KEY_PREFIX=huahuo-local
REDIS_MAXMEMORY=256mb

# 阿里云RAM 密钥（所有阿里云 AK 鉴权共用）
ALIYUN_RAM_ACCESS_KEY_ID=<RAM_ACCESS_KEY_ID>
ALIYUN_RAM_ACCESS_KEY_SECRET=<RAM_ACCESS_KEY_SECRET>

# Global object storage
STORAGE_DRIVER=local
STORAGE_LOCAL_ROOT=/app/var/storage
STORAGE_ALIYUN_OSS_REGION=cn-beijing
STORAGE_ALIYUN_OSS_ENDPOINT=https://oss-cn-beijing.aliyuncs.com
STORAGE_ALIYUN_OSS_BUCKET=huahuo-ai-assets-test
STORAGE_ALIYUN_OSS_SECURE=true
STORAGE_ALIYUN_OSS_TIMEOUT_MS=120000
STORAGE_ALIYUN_OSS_KEY_PREFIX=huahuo

# Global Milvus
MILVUS_ADDRESS=
MILVUS_USERNAME=
MILVUS_PASSWORD=
MILVUS_DATABASE=default
MILVUS_TLS=true
MILVUS_CREATE_IF_MISSING=true

# RAG ingestion lifecycle
RAG_PROVIDER_MODE=live
RAG_SOURCE_ALLOWED_HOSTS=oss.example.invalid
# Cloud test/main execution uses the provisioned workspace VPC cn-beijing API Host.
RAG_EMBEDDING_BASE_URL=https://ws-example-vpc-example.cn-beijing.maas.aliyuncs.com/api/v1
RAG_EMBEDDING_API_KEY=
RAG_EMBEDDING_MODEL=qwen3.7-text-embedding-flash
RAG_EMBEDDING_DIMENSIONS=1024
RAG_EMBEDDING_PROFILE=qwen3.7-text-embedding-flash-1024-fp16
RAG_RERANK_PROVIDER=disabled
RAG_RERANK_BASE_URL=https://ws-example-vpc-example.cn-beijing.maas.aliyuncs.com/api/v1
RAG_RERANK_API_KEY=
RAG_RERANK_MODEL=qwen3.7-text-rerank

# HTTP, application and provider settings
API_BIND_HOST=127.0.0.1
API_HOST_PORT=3000
ADMIN_BIND_HOST=127.0.0.1
ADMIN_HOST_PORT=3001
# Direct Admin port defaults to no proxy trust. Use 1 only behind a trusted adjacent proxy.
ADMIN_TRUST_PROXY_HOPS=0
# One trusted ingress hop; keep the application port private.
API_TRUST_PROXY_HOPS=1
APP_PUBLIC_BASE_URL=http://localhost:3000
ADMIN_PUBLIC_BASE_URL=http://localhost:3001
APP_TOKEN_SECRET=<GENERATED_APP_SECRET>
APP_JWT_ISSUER=huahuo-server
APP_JWT_AUDIENCE=huahuo-server,huahuo-agent
APP_JWT_SERVER_AUDIENCE=huahuo-server
APP_JWT_KEY_ID=server-current
APP_ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_SECONDS=2592000
APP_JWT_PRIVATE_KEY=<BASE64_ED25519_PRIVATE_KEY>
APP_JWT_PUBLIC_KEY=<BASE64_ED25519_PUBLIC_KEY>
APP_JWT_PREVIOUS_PUBLIC_KEY=
APP_JWT_PREVIOUS_KEY_ID=
# Shared entry authentication. Enable phone-login Studio only in development/test.
HUAHUO_STUDIO_AUTH_ENABLED=false
HUAHUO_STUDIO_ORIGIN=
HUAHUO_AGENT_PUBLIC_PATH=/agent
ADMIN_SESSION_SECRET=<GENERATED_ADMIN_SECRET>
PROVIDER_MODE=disabled
ALLOW_MOCK_PROVIDERS=false
USER_AGREEMENT_VERSION=REQUIRED_CONFIG
PRIVACY_POLICY_VERSION=REQUIRED_CONFIG


# gRPC 传输代理；直连时留空。Compose 访问本机代理用 host.docker.internal，宿主机用 127.0.0.1。
grpc_proxy=

# Knowledge base business modes (same runtime keys as .env.example)
KB_NOTE_HYBRID_COLLECTION=huahuo_kb_note_hybrid_chunks
KB_DOCUMENT_KEYWORD_COLLECTION=huahuo_kb_keyword_chunks

# Aliyun SMS is always real. API startup requires an approved sign, OTP template and RAM credentials.
SMS_ALIYUN_REGION_ID=cn-hangzhou
SMS_ALIYUN_SIGN_NAME=
SMS_ALIYUN_TEMPLATE_CODE=
SMS_ALIYUN_CODE_PARAM=code
SMS_ALIYUN_CONNECT_TIMEOUT_MS=3000
SMS_ALIYUN_READ_TIMEOUT_MS=3000
# Uses the existing ALIYUN_RAM_ACCESS_KEY_ID / ALIYUN_RAM_ACCESS_KEY_SECRET.

# Prometheus: labels derive from APP_ENV (development/test/production -> development/test/prod).
# On a test/cloud node set METRICS_BIND_HOST to its private IP for central scraping.
METRICS_ENABLED=true
METRICS_SERVICE=huahuo-server
METRICS_BIND_HOST=127.0.0.1
METRICS_API_HOST_PORT=9464
METRICS_ADMIN_HOST_PORT=9465
METRICS_WORKER_HOST_PORT=9466
METRICS_SCHEDULER_HOST_PORT=9467

# Drain timeout is stored in runtime_configuration: deployment.drainTimeoutMs (default 600000ms).

# API address reachable by other services and parser callbacks. Empty follows APP_PUBLIC_BASE_URL.
# When Admin runs elsewhere, set the API private IP or service DNS here; keep Admin URL separate.
API_SERVICE_BASE_URL=
