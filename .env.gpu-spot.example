# Standalone low-level module configuration, disabled by default.
# Not injected into Compose roles until the owning Task/Worker integration is accepted.
GPU_SPOT_PROVIDER=disabled
GPU_SPOT_REGION_ID=cn-beijing
GPU_SPOT_VPC_ID=
# OSS/ECI share root .env: ALIYUN_RAM_ACCESS_KEY_ID / ALIYUN_RAM_ACCESS_KEY_SECRET.
# Optional STS: ALIYUN_RAM_SECURITY_TOKEN. No second GPU-specific credential pair.
GPU_SPOT_SECURITY_GROUP_ID=
# Same VPC; up to 10 switches across zones in the selected region.
GPU_SPOT_VSWITCH_IDS=
# Each candidate has 1 x NVIDIA T4 16 GB. Order is the requested priority:
# 4 vCPU/15 GiB -> 8/31 -> 16/62 -> 24/93. ECI retries in this order.
GPU_SPOT_INSTANCE_TYPES=ecs.gn6i-c4g1.xlarge,ecs.gn6i-c8g1.2xlarge,ecs.gn6i-c16g1.4xlarge,ecs.gn6i-c24g1.6xlarge
# User-selected startup smoke image; GPU compute needs its own workload validation.
GPU_SPOT_IMAGE=registry-vpc.cn-beijing.aliyuncs.com/eci_open/nginx:latest
GPU_SPOT_GPU_COUNT=1
GPU_SPOT_STRATEGY=SpotAsPriceGo
# Only for SpotWithPriceLimit; at most 3 decimal places.
GPU_SPOT_PRICE_LIMIT=
GPU_SPOT_DURATION_HOURS=1
GPU_SPOT_ACTIVE_DEADLINE_SECONDS=3600
# Optional major version, e.g. tesla=580; verify image CUDA compatibility.
GPU_SPOT_DRIVER_VERSION=
GPU_SPOT_RESOURCE_GROUP_ID=
GPU_SPOT_MAX_ATTEMPTS=6
GPU_SPOT_INITIAL_DELAY_MS=2000
GPU_SPOT_MAX_DELAY_MS=60000
GPU_SPOT_CONNECT_TIMEOUT_MS=5000
GPU_SPOT_READ_TIMEOUT_MS=15000
