# GPU Spot 独立工具配置；凭据读取根 .env。

# 云资源
GPU_SPOT_PROVIDER=disabled
GPU_SPOT_REGION_ID=cn-beijing
GPU_SPOT_VPC_ID=
GPU_SPOT_SECURITY_GROUP_ID=
GPU_SPOT_VSWITCH_IDS=
GPU_SPOT_INSTANCE_TYPES=ecs.gn6i-c4g1.xlarge,ecs.gn6i-c8g1.2xlarge,ecs.gn6i-c16g1.4xlarge,ecs.gn6i-c24g1.6xlarge

# 镜像与运行
GPU_SPOT_IMAGE=registry-vpc.cn-beijing.aliyuncs.com/eci_open/nginx:latest
GPU_SPOT_GPU_COUNT=1
GPU_SPOT_DURATION_HOURS=1
GPU_SPOT_ACTIVE_DEADLINE_SECONDS=3600
GPU_SPOT_DRIVER_VERSION=
GPU_SPOT_RESOURCE_GROUP_ID=

# 竞价策略
GPU_SPOT_STRATEGY=SpotAsPriceGo
GPU_SPOT_PRICE_LIMIT=

# 重试与超时
GPU_SPOT_MAX_ATTEMPTS=6
GPU_SPOT_INITIAL_DELAY_MS=2000
GPU_SPOT_MAX_DELAY_MS=60000
GPU_SPOT_CONNECT_TIMEOUT_MS=5000
GPU_SPOT_READ_TIMEOUT_MS=15000
