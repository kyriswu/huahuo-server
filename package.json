{
  "name": "huahuo-server",
  "version": "0.3.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=26.11.0 <27"
  },
  "packageManager": "pnpm@10.15.1",
  "volta": {
    "node": "26.11.0",
    "pnpm": "10.15.1"
  },
  "scripts": {
    "build": "node scripts/clean-build.mjs && tsc -p tsconfig.build.json && pnpm build:admin-ui",
    "build:admin-ui": "vite build admin-ui",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p admin-ui/tsconfig.json",
    "lint": "eslint src tests scripts/*.mjs scripts/release/*.mjs admin-ui",
    "release:smoke": "node scripts/release/smoke.mjs",
    "release:check": "node dist/entrypoints/release-plan.js",
    "release:review": "node dist/entrypoints/release-plan.js --review",
    "test": "vitest run tests/unit tests/contract --exclude '**/.local/**'",
    "test:unit": "vitest run tests/unit",
    "test:contract": "vitest run tests/contract",
    "test:integration": "node scripts/integration.mjs",
    "app:reference": "node scripts/app-reference.mjs",
    "app:reference:diff": "node scripts/app-reference.mjs --diff",
    "local:preflight": "node scripts/preflight-local.mjs",
    "gpu:preflight": "node --env-file=.env.gpu-spot dist/entrypoints/gpu-spot-preflight.js",
    "sms": "node --env-file-if-exists=.env --import tsx src/entrypoints/sms.ts",
    "document-parser:machine": "node --env-file-if-exists=.env --import tsx src/entrypoints/document-parser-machine.ts",
    "local:docker:ensure": "bash scripts/ensure-docker-local.sh",
    "compose": "docker compose",
    "compose:validate": "docker compose --env-file .env config --quiet",
    "compose:up": "docker compose --env-file .env up -d --build",
    "compose:down": "docker compose --env-file .env down",
    "db:migrate": "docker compose --env-file .env run --rm migrate",
    "db:sync:local": "node --import tsx deploy/local/sync-db.mjs",
    "verify": "node scripts/verify.mjs",
    "start:api-server": "node --enable-source-maps dist/entrypoints/api-server.js",
    "start:admin": "node --enable-source-maps dist/entrypoints/admin.js",
    "start:worker": "node --enable-source-maps dist/entrypoints/worker.js",
    "start:scheduler": "node --enable-source-maps dist/entrypoints/scheduler.js",
    "dev:local": "node --watch --enable-source-maps --import tsx deploy/local/run.mjs",
    "dev:admin-ui": "vite admin-ui",
    "test:e2e": "node scripts/e2e-p03.mjs",
    "test:e2e:p02": "node scripts/e2e-p02.mjs",
    "test:container-isolation": "node scripts/container-isolation.mjs",
    "infra:up": "docker compose --env-file .env up -d redis",
    "infra:down": "docker compose --env-file .env stop redis",
    "db:generate": "node scripts/new-migration.mjs",
    "test:integration:inner": "vitest run tests/integration --exclude '**/.local/**'",
    "rag:consistency": "node --env-file=.env scripts/rag-consistency.mjs",
    "rag:verify-milvus": "pnpm build && node --env-file=.env scripts/verify-milvus.mjs",
    "admin:bootstrap": "node dist/entrypoints/admin-bootstrap.js",
    "admin:revoke-sessions": "node dist/entrypoints/admin-revoke-sessions.js"
  },
  "dependencies": {
    "@alicloud/dysmsapi20170525": "4.6.0",
    "@alicloud/eci20180808": "2.1.2",
    "@alicloud/openapi-core": "1.0.9",
    "@aws-sdk/client-s3": "3.1149.0",
    "@darabonba/typescript": "1.0.6",
    "@fastify/static": "10.1.10",
    "@fastify/swagger": "9.5.1",
    "@fastify/type-provider-typebox": "5.2.0",
    "@opentelemetry/api": "1.10.0",
    "@opentelemetry/context-async-hooks": "3.1.1",
    "@opentelemetry/core": "3.1.1",
    "@opentelemetry/exporter-trace-otlp-http": "0.301.2",
    "@opentelemetry/resources": "3.1.1",
    "@opentelemetry/sdk-trace": "3.1.1",
    "@prometheus-io/client": "0.16.1",
    "@sinclair/typebox": "0.34.41",
    "@zilliz/milvus2-sdk-node": "2.6.17",
    "ali-oss": "6.23.0",
    "bullmq": "6.3.12",
    "drizzle-orm": "0.44.5",
    "fastify": "5.12.5",
    "ioredis": "5.6.1",
    "jose": "6.1.0",
    "markdown-it": "15.0.3",
    "mdast-util-from-markdown": "2.0.3",
    "pg": "8.16.3"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@tailwindcss/vite": "4.3.4",
    "@types/markdown-it": "14.2.0",
    "@types/node": "24.3.0",
    "@types/pg": "8.15.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "antd": "6.7.0",
    "eslint": "10.12.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "tailwindcss": "4.3.4",
    "tsx": "4.20.3",
    "typescript": "5.9.2",
    "typescript-eslint": "8.71.1",
    "vite": "7.3.7",
    "vitest": "3.2.4"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  }
}
