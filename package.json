{
  "name": "huahuo-server",
  "version": "0.3.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=26.11.0 <27"
  },
  "packageManager": "pnpm@10.15.1",
  "volta": {
    "node": "26.11.0",
    "pnpm": "10.15.1"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json && pnpm build:admin-ui",
    "build:admin-ui": "vite build admin-ui",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p admin-ui/tsconfig.json",
    "lint": "eslint src tests scripts/*.mjs admin-ui",
    "test": "vitest run tests/unit tests/contract",
    "test:unit": "vitest run tests/unit",
    "test:contract": "vitest run tests/contract",
    "test:integration": "node scripts/integration.mjs",
    "app:reference": "node scripts/app-reference.mjs",
    "app:reference:diff": "node scripts/app-reference.mjs --diff",
    "local:preflight": "node scripts/preflight-local.mjs",
    "local:docker:ensure": "bash scripts/ensure-docker-local.sh",
    "compose:validate": "docker compose --env-file .env config --quiet",
    "compose:up": "docker compose --env-file .env up -d --build",
    "compose:down": "docker compose --env-file .env down",
    "db:migrate": "docker compose --env-file .env run --rm migrate",
    "verify": "node scripts/verify.mjs",
    "start:api-server": "node dist/entrypoints/api-server.js",
    "start:admin": "node dist/entrypoints/admin.js",
    "start:worker": "node dist/entrypoints/worker.js",
    "start:scheduler": "node dist/entrypoints/scheduler.js",
    "dev:api-server": "tsx src/entrypoints/api-server.ts",
    "dev:admin": "tsx src/entrypoints/admin.ts",
    "dev:admin-ui": "vite admin-ui --mode demo",
    "dev:worker": "tsx src/entrypoints/worker.ts",
    "dev:scheduler": "tsx src/entrypoints/scheduler.ts",
    "test:e2e": "node scripts/e2e-p03.mjs",
    "test:e2e:p02": "node scripts/e2e-p02.mjs",
    "test:container-isolation": "node scripts/container-isolation.mjs",
    "infra:up": "docker compose --env-file .env up -d redis",
    "infra:down": "docker compose --env-file .env stop redis",
    "db:seed:dev": "tsx src/db/seed.ts",
    "db:generate": "node scripts/new-migration.mjs",
    "test:integration:inner": "vitest run tests/integration",
    "test:rag-fixture": "pnpm build && node scripts/verify-rag-fixture.mjs",
    "rag:consistency": "node --env-file=.env scripts/rag-consistency.mjs",
    "rag:verify-milvus": "pnpm build && node --env-file=.env scripts/verify-milvus.mjs",
    "admin:bootstrap": "node dist/entrypoints/admin-bootstrap.js",
    "admin:revoke-sessions": "node dist/entrypoints/admin-revoke-sessions.js"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.1149.0",
    "@fastify/static": "10.1.10",
    "@fastify/swagger": "9.5.1",
    "@fastify/type-provider-typebox": "5.2.0",
    "@huggingface/tokenizers": "0.2.0",
    "@langchain/textsplitters": "1.0.2",
    "@sinclair/typebox": "0.34.41",
    "@zilliz/milvus2-sdk-node": "2.6.17",
    "ali-oss": "6.23.0",
    "bullmq": "6.3.12",
    "diff": "9.0.0",
    "drizzle-orm": "0.44.5",
    "fastify": "5.12.5",
    "fflate": "0.8.2",
    "file-type": "22.1.1",
    "ioredis": "5.6.1",
    "jose": "6.1.0",
    "mammoth": "1.13.0",
    "markdown-it": "15.0.3",
    "music-metadata": "12.1.0",
    "pdf-parse": "1.1.1",
    "pg": "8.16.3"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@tailwindcss/vite": "4.3.4",
    "@types/markdown-it": "14.2.0",
    "@types/node": "24.3.0",
    "@types/pg": "8.15.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "antd": "6.7.0",
    "eslint": "10.12.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "tailwindcss": "4.3.4",
    "tsx": "4.20.3",
    "typescript": "5.9.2",
    "typescript-eslint": "8.71.1",
    "vite": "7.3.7",
    "vitest": "3.2.4"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  }
}
