# 示例，不是真实凭据或可立即拉取的镜像；P01替换并生成实际.env.compose.local。
# 此文件供Compose插值，不可整个env_file传给所有角色。
COMPOSE_PROJECT_NAME=huahuo-server-dev
COMPOSE_PROFILES=local-db
APP_ENV=development
NODE_IMAGE=node:<PINNED_NODE24_TAG_OR_DIGEST>
PNPM_VERSION=<EXACT_STABLE_VERSION>
POSTGRES_IMAGE=postgres:<PINNED_PG17_TAG_OR_DIGEST>
REDIS_IMAGE=redis:<PINNED_STABLE_TAG_OR_DIGEST>
BACKEND_IMAGE=huahuo-server:dev

# P01可生成随机hex口令；同一角色URL中的值须与初始化密码相同。
POSTGRES_BOOTSTRAP_PASSWORD=<GENERATED_BOOTSTRAP>
POSTGRES_MIGRATOR_PASSWORD=<GENERATED_MIGRATOR>
POSTGRES_API_PASSWORD=<GENERATED_API_DB>
POSTGRES_ADMIN_PASSWORD=<GENERATED_ADMIN_DB>
POSTGRES_WORKER_PASSWORD=<GENERATED_WORKER_DB>
POSTGRES_SCHEDULER_PASSWORD=<GENERATED_SCHEDULER_DB>
DATABASE_MIGRATION_URL=postgresql://huahuo_migrator:<GENERATED_MIGRATOR>@postgres:5432/huahuo
DATABASE_API_URL=postgresql://huahuo_api:<GENERATED_API_DB>@postgres:5432/huahuo
DATABASE_ADMIN_URL=postgresql://huahuo_admin:<GENERATED_ADMIN_DB>@postgres:5432/huahuo
DATABASE_WORKER_URL=postgresql://huahuo_worker:<GENERATED_WORKER_DB>@postgres:5432/huahuo
DATABASE_SCHEDULER_URL=postgresql://huahuo_scheduler:<GENERATED_SCHEDULER_DB>@postgres:5432/huahuo
DATABASE_SSL_MODE=disable
DATABASE_SSL_CA_FILE=
DATABASE_POOL_MAX_API=10
DATABASE_POOL_MAX_ADMIN=5
DATABASE_POOL_MAX_WORKER=10
DATABASE_POOL_MAX_SCHEDULER=3
DB_SCHEMA_MIN_VERSION=1
REDIS_CACHE_URL=redis://redis:6379/0
REDIS_QUEUE_URL=redis://redis:6379/1
REDIS_KEY_PREFIX=huahuo-local
REDIS_MAXMEMORY=256mb

API_BIND_HOST=127.0.0.1
API_HOST_PORT=3000
ADMIN_BIND_HOST=127.0.0.1
ADMIN_HOST_PORT=3001
APP_PUBLIC_BASE_URL=http://localhost:3000
ADMIN_PUBLIC_BASE_URL=http://localhost:3001
APP_TOKEN_SECRET=<GENERATED_APP_SECRET>
TOOL_TOKEN_SECRET=<GENERATED_TOOL_SECRET>
ADMIN_SESSION_SECRET=<GENERATED_ADMIN_SECRET>
STORAGE_DRIVER=local
WORKFLOW_PROVIDER=disabled
ASR_PROVIDER=disabled
PAYMENT_ENABLED=false
DIFY_BASE_URL=
DIFY_API_KEY=
# P02/P08启用本地mock必须显式开发配置；生产不允许mock。
# 发布按真实provider增加角色所需secret，不把所有密钥传给所有容器。

# v3：App只在宿主编码时从../huahuo-app读取，不给业务容器注入APP_LOCAL_PATH。
# 已有本项目环境禁止重复生成口令/改project名；新默认名不负责自动迁移旧卷。
# 真机/云工具访问地址参见12规范；默认只有本机回环访问。
INTERNAL_API_BASE_URL=http://api-server:3000
TOOLS_PUBLIC_BASE_URL=
