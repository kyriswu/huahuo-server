# 仍是同一compose.yaml；此例只描述云PG连接，不自动迁移已有数据。
COMPOSE_PROJECT_NAME=huahuo-server-cloud-test
COMPOSE_PROFILES=
APP_ENV=development
NODE_IMAGE=node:<PINNED_NODE24_TAG_OR_DIGEST>
PNPM_VERSION=<EXACT_STABLE_VERSION>
REDIS_IMAGE=redis:<PINNED_STABLE_TAG_OR_DIGEST>
BACKEND_IMAGE=huahuo-server:dev

# Compose可能先插值被停用profile的字段，保留非秘密占位供模型加载。
# cloud时不启动postgres，以下不是云PG口令。
POSTGRES_IMAGE=postgres:<PINNED_PG17_TAG_OR_DIGEST>
POSTGRES_BOOTSTRAP_PASSWORD=unused-local-bootstrap
POSTGRES_MIGRATOR_PASSWORD=unused-local-migrator
POSTGRES_API_PASSWORD=unused-local-api
POSTGRES_ADMIN_PASSWORD=unused-local-admin
POSTGRES_WORKER_PASSWORD=unused-local-worker
POSTGRES_SCHEDULER_PASSWORD=unused-local-scheduler

# 云上预先授权准备角色；URI密码必须编码，TLS主机名匹配证书。
DATABASE_MIGRATION_URL=postgresql://<MIGRATION_ROLE>:<PASSWORD>@<CLOUD_PG_ENDPOINT>:5432/<DATABASE>
DATABASE_API_URL=postgresql://<API_ROLE>:<PASSWORD>@<CLOUD_PG_ENDPOINT>:5432/<DATABASE>
DATABASE_ADMIN_URL=postgresql://<ADMIN_ROLE>:<PASSWORD>@<CLOUD_PG_ENDPOINT>:5432/<DATABASE>
DATABASE_WORKER_URL=postgresql://<WORKER_ROLE>:<PASSWORD>@<CLOUD_PG_ENDPOINT>:5432/<DATABASE>
DATABASE_SCHEDULER_URL=postgresql://<SCHEDULER_ROLE>:<PASSWORD>@<CLOUD_PG_ENDPOINT>:5432/<DATABASE>
DATABASE_SSL_MODE=verify-full
DATABASE_SSL_CA_FILE=/app/certs/cloud-pg-ca.pem
DATABASE_POOL_MAX_API=10
DATABASE_POOL_MAX_ADMIN=5
DATABASE_POOL_MAX_WORKER=10
DATABASE_POOL_MAX_SCHEDULER=3
DB_SCHEMA_MIN_VERSION=1
REDIS_CACHE_URL=redis://redis:6379/0
REDIS_QUEUE_URL=redis://redis:6379/1
REDIS_KEY_PREFIX=huahuo-cloud-test
REDIS_MAXMEMORY=256mb
API_BIND_HOST=127.0.0.1
API_HOST_PORT=3000
ADMIN_BIND_HOST=127.0.0.1
ADMIN_HOST_PORT=3001
APP_PUBLIC_BASE_URL=http://localhost:3000
ADMIN_PUBLIC_BASE_URL=http://localhost:3001
APP_TOKEN_SECRET=<GENERATED_APP_SECRET>
TOOL_TOKEN_SECRET=<GENERATED_TOOL_SECRET>
ADMIN_SESSION_SECRET=<GENERATED_ADMIN_SECRET>
STORAGE_DRIVER=local
WORKFLOW_PROVIDER=disabled
ASR_PROVIDER=disabled
PAYMENT_ENABLED=false
DIFY_BASE_URL=
DIFY_API_KEY=
# 云PG配合本地volume只保证单机后端共享文件；未来多机改对象存储。
# 正式启用前另改APP_ENV、provider、HTTPS地址和真实secret，禁止直接上线示例。

# v3：App只在宿主编码时从../huahuo-app读取，不给业务容器注入APP_LOCAL_PATH。
# 已有本项目环境禁止重复生成口令/改project名；新默认名不负责自动迁移旧卷。
# 真机/云工具访问地址参见12规范；默认只有本机回环访问。
INTERNAL_API_BASE_URL=http://api-server:3000
TOOLS_PUBLIC_BASE_URL=
