# 云端配置示例；实际运行以根目录模板为准。

# 运行与容器
COMPOSE_PROJECT_NAME=huahuo-server-cloud-test
COMPOSE_PROFILES=
APP_ENV=development
NODE_IMAGE=node:<PINNED_NODE26_TAG_OR_DIGEST>
PNPM_VERSION=<EXACT_STABLE_VERSION>
POSTGRES_IMAGE=postgres:<PINNED_PG17_TAG_OR_DIGEST>
REDIS_IMAGE=redis:<PINNED_STABLE_TAG_OR_DIGEST>
BACKEND_IMAGE=huahuo-server:dev
ALLOW_MOCK_PROVIDERS=false

# HTTP 与服务地址
API_BIND_HOST=127.0.0.1
API_HOST_PORT=3000
ADMIN_BIND_HOST=127.0.0.1
ADMIN_HOST_PORT=3001
APP_PUBLIC_BASE_URL=https://<APP_HOST>
ADMIN_PUBLIC_BASE_URL=https://<ADMIN_HOST>

# PostgreSQL
POSTGRES_BOOTSTRAP_PASSWORD=unused-local-bootstrap
POSTGRES_MIGRATOR_PASSWORD=unused-local-migrator
POSTGRES_API_PASSWORD=unused-local-api
POSTGRES_ADMIN_PASSWORD=unused-local-admin
POSTGRES_WORKER_PASSWORD=unused-local-worker
POSTGRES_SCHEDULER_PASSWORD=unused-local-scheduler
DATABASE_MIGRATION_URL=postgresql://<MIGRATION_ROLE>:<PASSWORD>@<CLOUD_PG_ENDPOINT>:5432/<DATABASE>
DATABASE_API_URL=postgresql://<API_ROLE>:<PASSWORD>@<CLOUD_PG_ENDPOINT>:5432/<DATABASE>
DATABASE_ADMIN_URL=postgresql://<ADMIN_ROLE>:<PASSWORD>@<CLOUD_PG_ENDPOINT>:5432/<DATABASE>
DATABASE_WORKER_URL=postgresql://<WORKER_ROLE>:<PASSWORD>@<CLOUD_PG_ENDPOINT>:5432/<DATABASE>
DATABASE_SCHEDULER_URL=postgresql://<SCHEDULER_ROLE>:<PASSWORD>@<CLOUD_PG_ENDPOINT>:5432/<DATABASE>
DATABASE_URL=
DATABASE_SSL_MODE=verify-full
DATABASE_SSL_CA_FILE=/app/certs/cloud-pg-ca.pem
DATABASE_POOL_MAX_API=10
DATABASE_POOL_MAX_ADMIN=5
DATABASE_POOL_MAX_WORKER=10
DATABASE_POOL_MAX_SCHEDULER=3
DB_SCHEMA_MIN_VERSION=1

# Redis
REDIS_CACHE_URL=redis://redis:6379/0
REDIS_QUEUE_URL=redis://redis:6379/1
REDIS_KEY_PREFIX=huahuo-cloud-test
REDIS_MAXMEMORY=256mb

# 用户与管理认证
APP_TOKEN_SECRET=<GENERATED_APP_SECRET>
APP_JWT_ISSUER=huahuo-server
APP_JWT_AUDIENCE=huahuo-server,huahuo-agent
APP_JWT_SERVER_AUDIENCE=huahuo-server
APP_JWT_KEY_ID=server-current
APP_ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_SECONDS=2592000
APP_JWT_PRIVATE_KEY=<BASE64_ED25519_PRIVATE_KEY>
APP_JWT_PUBLIC_KEY=<BASE64_ED25519_PUBLIC_KEY>
ADMIN_SESSION_SECRET=<GENERATED_ADMIN_SECRET>

# 阿里云 RAM
ALIYUN_RAM_ACCESS_KEY_ID=<RAM_ACCESS_KEY_ID>
ALIYUN_RAM_ACCESS_KEY_SECRET=<RAM_ACCESS_KEY_SECRET>

# 对象存储
STORAGE_DRIVER=aliyun-oss
STORAGE_LOCAL_ROOT=/app/var/storage
STORAGE_ALIYUN_OSS_REGION=cn-beijing
STORAGE_ALIYUN_OSS_ENDPOINT=https://oss-cn-beijing.aliyuncs.com
STORAGE_ALIYUN_OSS_BUCKET=<OSS_BUCKET>
STORAGE_ALIYUN_OSS_SECURE=true
STORAGE_ALIYUN_OSS_TIMEOUT_MS=120000
STORAGE_ALIYUN_OSS_KEY_PREFIX=huahuo

# Milvus
MILVUS_ADDRESS=<MILVUS_ENDPOINT>
MILVUS_USERNAME=<MILVUS_USERNAME>
MILVUS_PASSWORD=<MILVUS_PASSWORD>
MILVUS_DATABASE=default
MILVUS_TLS=true
MILVUS_CREATE_IF_MISSING=false

# RAG 模型连接
# 云端使用北京私网地址。
RAG_PROVIDER_MODE=live
RAG_SOURCE_ALLOWED_HOSTS=<OSS_ALLOWED_HOST>
RAG_EMBEDDING_BASE_URL=https://ws-example-vpc-example.cn-beijing.maas.aliyuncs.com/api/v1
RAG_EMBEDDING_API_KEY=<EMBEDDING_API_KEY>
RAG_EMBEDDING_MODEL=qwen3.7-text-embedding-flash
RAG_EMBEDDING_DIMENSIONS=1024
RAG_EMBEDDING_PROFILE=qwen3.7-text-embedding-flash-1024-fp16
RAG_RERANK_PROVIDER=disabled

# gRPC 代理
# 直连时留空。
grpc_proxy=

# 知识索引集合
KB_CONTENT_ASSET_HYBRID_COLLECTION=huahuo_kb_note_hybrid_chunks
KB_DOCUMENT_KEYWORD_COLLECTION=huahuo_kb_keyword_chunks

# 短信
SMS_ALIYUN_REGION_ID=cn-hangzhou
SMS_ALIYUN_SIGN_NAME=
SMS_ALIYUN_TEMPLATE_CODE=
SMS_ALIYUN_CODE_PARAM=code
SMS_ALIYUN_CONNECT_TIMEOUT_MS=3000
SMS_ALIYUN_READ_TIMEOUT_MS=3000

# 用户协议版本
USER_AGREEMENT_VERSION=REQUIRED_CONFIG
PRIVACY_POLICY_VERSION=REQUIRED_CONFIG
