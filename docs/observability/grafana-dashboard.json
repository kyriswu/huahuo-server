      "type": "timeseries",
      "title": "Agent Run 终态 / 秒",
      "description": "",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "x": 0,
        "y": 44,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (env, agent, outcome) (rate(agent_runs_total{env=~\"$env\",service=~\"$service\",role=~\"$role\",instance=~\"$instance\"}[$__rate_interval]))",
