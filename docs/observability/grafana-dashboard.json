{
  "__inputs": [
    {
      "name": "DS_PROMETHEUS",
      "label": "Prometheus",
      "type": "datasource",
      "pluginId": "prometheus",
      "pluginName": "Prometheus"
    }
  ],
  "id": null,
  "uid": "huahuo-observability-v1",
  "title": "花火 · 服务与调用链",
  "tags": [
    "huahuo",
    "observability"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "editable": true,
  "refresh": "30s",
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "templating": {
    "list": [
      {
        "name": "env",
        "label": "env",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "${DS_PROMETHEUS}"
        },
        "query": {
          "query": "label_values(application_info, env)",
          "refId": "variable-env"
        },
        "definition": "label_values(application_info, env)",
        "refresh": 1,
        "multi": true,
        "includeAll": true,
        "allValue": ".*",
        "current": {
          "selected": true,
          "text": "All",
          "value": "$__all"
        },
        "options": []
      },
      {
        "name": "service",
        "label": "service",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "${DS_PROMETHEUS}"
        },
        "query": {
          "query": "label_values(application_info{env=~\"$env\"}, service)",
          "refId": "variable-service"
        },
        "definition": "label_values(application_info{env=~\"$env\"}, service)",
        "refresh": 1,
        "multi": true,
        "includeAll": true,
        "allValue": ".*",
        "current": {
          "selected": true,
          "text": "All",
          "value": "$__all"
        },
        "options": []
      },
      {
        "name": "role",
        "label": "role",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "${DS_PROMETHEUS}"
        },
        "query": {
          "query": "label_values(application_info{env=~\"$env\",service=~\"$service\"}, role)",
          "refId": "variable-role"
        },
        "definition": "label_values(application_info{env=~\"$env\",service=~\"$service\"}, role)",
        "refresh": 1,
        "multi": true,
        "includeAll": true,
        "allValue": ".*",
        "current": {
          "selected": true,
          "text": "All",
          "value": "$__all"
        },
        "options": []
      },
      {
        "name": "instance",
        "label": "instance",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "${DS_PROMETHEUS}"
        },
        "query": {
          "query": "label_values(application_info{env=~\"$env\",service=~\"$service\",role=~\"$role\"}, instance)",
          "refId": "variable-instance"
        },
        "definition": "label_values(application_info{env=~\"$env\",service=~\"$service\",role=~\"$role\"}, instance)",
        "refresh": 1,
        "multi": true,
        "includeAll": true,
        "allValue": ".*",
        "current": {
          "selected": true,
          "text": "All",
          "value": "$__all"
        },
        "options": []
      }
    ]
  },
  "annotations": {
    "list": []
  },
  "panels": [
    {
      "id": 1,
      "type": "row",
      "title": "数据覆盖与服务身份",
      "description": "无数据、抓取失败和业务零流量分别呈现。Prometheus targets需为每个实际实例配置env/service/role。",
      "collapsed": false,
      "panels": [],
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 1
      }
    },
    {
      "id": 2,
      "type": "table",
      "title": "应用实例与版本",
      "description": "元信息包含version与service_instance_id。instance是Prometheus抓取目标，二者不混用。",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "x": 0,
        "y": 1,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "application_info{env=~\"$env\",service=~\"$service\",role=~\"$role\",instance=~\"$instance\"}",
          "legendFormat": "{{service}} / {{role}}",
          "range": false,
          "instant": true,
          "format": "table"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "noValue": "无数据",
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "linear",
            "lineWidth": 1,
            "fillOpacity": 8,
            "spanNulls": false
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "lastNotNull"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "抓取可达性（1可达，0失败）",
      "description": "up来自抓取端。未配置target时没有样本，不会自动变成0或触发告警。",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "x": 12,
        "y": 1,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "up{env=~\"$env\",service=~\"$service\",role=~\"$role\",instance=~\"$instance\"}",
          "legendFormat": "{{service}} / {{instance}}",
          "range": true,
          "instant": false,
          "format": "time_series"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "noValue": "无数据",
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "linear",
            "lineWidth": 1,
            "fillOpacity": 8,
            "spanNulls": false
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "lastNotNull"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "id": 4,
      "type": "row",
      "title": "HTTP 响应与连接",
      "description": "HTTP完成不代表SSE业务或任务成功；公网、内部、Admin分开看，健康/metrics探针不进入业务计数。",
      "collapsed": false,
      "panels": [],
      "gridPos": {
        "x": 0,
        "y": 9,
        "w": 24,
        "h": 1
      }
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "已完成 HTTP 响应 / 秒",
      "description": "",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "x": 0,
        "y": 10,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (env, service, role, traffic) (rate(http_requests_total{env=~\"$env\",service=~\"$service\",role=~\"$role\",instance=~\"$instance\"}[$__rate_interval]))",
          "legendFormat": "{{env}} / {{service}} / {{role}} / {{traffic}}",
          "range": true,
          "instant": false,
          "format": "time_series"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "noValue": "无数据",
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "linear",
            "lineWidth": 1,
            "fillOpacity": 8,
            "spanNulls": false
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "lastNotNull"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "已完成 HTTP 响应 P95",
      "description": "聚合所有实例的桶后计算；包含完整SSE连接寿命，不能解读为模型生成耗时。",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "x": 12,
        "y": 10,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.95, sum by (env, le, service, role, traffic) (rate(http_request_duration_seconds_bucket{env=~\"$env\",service=~\"$service\",role=~\"$role\",instance=~\"$instance\"}[$__rate_interval])))",
          "legendFormat": "{{env}} / {{service}} / {{role}} / {{traffic}}",
          "range": true,
          "instant": false,
          "format": "time_series"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "noValue": "无数据",
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "linear",
            "lineWidth": 1,
            "fillOpacity": 8,
            "spanNulls": false
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "lastNotNull"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "已完成响应中的 5xx 比例",
      "description": "零流量时保留NaN/无数据，不填100%成功；4xx与客户端中断另列。",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "x": 0,
        "y": 18,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "(sum by (env, service, role, traffic) (rate(http_requests_total{env=~\"$env\",service=~\"$service\",role=~\"$role\",instance=~\"$instance\",outcome=\"server_error\"}[$__rate_interval])) or on(env, service, role, traffic) (0 * sum by (env, service, role, traffic) (rate(http_requests_total{env=~\"$env\",service=~\"$service\",role=~\"$role\",instance=~\"$instance\"}[$__rate_interval])))) / sum by (env, service, role, traffic) (rate(http_requests_total{env=~\"$env\",service=~\"$service\",role=~\"$role\",instance=~\"$instance\"}[$__rate_interval]))",
          "legendFormat": "{{env}} / {{service}} / {{role}} / {{traffic}}",
          "range": true,
          "instant": false,
          "format": "time_series"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "noValue": "无数据",
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "linear",
            "lineWidth": 1,
            "fillOpacity": 8,
            "spanNulls": false
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "lastNotNull"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "id": 8,
      "type": "timeseries",
      "title": "HTTP 中断 / 秒",
      "description": "",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "x": 12,
        "y": 18,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (env, service, role, traffic, reason) (rate(http_aborted_requests_total{env=~\"$env\",service=~\"$service\",role=~\"$role\",instance=~\"$instance\"}[$__rate_interval]))",
          "legendFormat": "{{env}} / {{service}} / {{role}} / {{reason}} / {{traffic}}",
          "range": true,
          "instant": false,
          "format": "time_series"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "noValue": "无数据",
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "linear",
            "lineWidth": 1,
            "fillOpacity": 8,
            "spanNulls": false
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "lastNotNull"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "id": 9,
      "type": "timeseries",
      "title": "HTTP 当前在途（含流连接）",
      "description": "",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "x": 0,
        "y": 26,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (env, service, role) (http_requests_in_flight{env=~\"$env\",service=~\"$service\",role=~\"$role\",instance=~\"$instance\"})",
          "legendFormat": "{{env}} / {{service}} / {{role}}",
          "range": true,
          "instant": false,
          "format": "time_series"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "noValue": "无数据",
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "linear",
            "lineWidth": 1,
            "fillOpacity": 8,
            "spanNulls": false
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "lastNotNull"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "id": 10,
      "type": "timeseries",
      "title": "流连接终止原因 / 秒",
      "description": "连接关闭和业务终态不同；Agent模型/Run见后续面板。",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "x": 12,
        "y": 26,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (env, service, kind, outcome) (rate(stream_sessions_total{env=~\"$env\",service=~\"$service\",role=~\"$role\",instance=~\"$instance\"}[$__rate_interval]))",
          "legendFormat": "{{env}} / {{service}} / {{kind}} / {{outcome}}",
          "range": true,
          "instant": false,
          "format": "time_series"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ops",
          "noValue": "无数据",
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "linear",
            "lineWidth": 1,
            "fillOpacity": 8,
            "spanNulls": false
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "lastNotNull"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "id": 11,
      "type": "row",
      "title": "服务间 HTTP 调用",
      "description": "仅统计实际经过公共HTTP客户端的尝试；SDK内部网络不伪计数。不要把调用方与服务端请求量相加当作用户请求数。",
      "collapsed": false,
      "panels": [],
      "gridPos": {
        "x": 0,
        "y": 34,
        "w": 24,
        "h": 1
      }
    },
    {
      "id": 12,
      "type": "timeseries",
      "title": "出站调用 / 秒",
      "description": "",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "x": 0,
        "y": 35,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (env, service, dependency, operation, outcome) (rate(http_client_requests_total{env=~\"$env\",service=~\"$service\",role=~\"$role\",instance=~\"$instance\"}[$__rate_interval]))",
          "legendFormat": "{{env}} / {{service}} → {{dependency}} / {{operation}} / {{outcome}}",
          "range": true,
          "instant": false,
          "format": "time_series"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ops",
          "noValue": "无数据",
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "linear",
            "lineWidth": 1,
            "fillOpacity": 8,
            "spanNulls": false
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "lastNotNull"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "id": 13,
      "type": "timeseries",
      "title": "出站完整响应 P95",
      "description": "包含响应体消费；timeout/cancel和response_error可使用outcome过滤。",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "x": 12,
        "y": 35,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.95, sum by (env, le, service, dependency, operation) (rate(http_client_request_duration_seconds_bucket{env=~\"$env\",service=~\"$service\",role=~\"$role\",instance=~\"$instance\"}[$__rate_interval])))",
          "legendFormat": "{{env}} / {{service}} → {{dependency}} / {{operation}}",
          "range": true,
          "instant": false,
          "format": "time_series"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "noValue": "无数据",
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "linear",
            "lineWidth": 1,
            "fillOpacity": 8,
            "spanNulls": false
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "lastNotNull"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "id": 14,
      "type": "row",
      "title": "Agent、模型与工具",
      "description": "Run终态、可恢复段、provider调用分别统计。取消不等于失败或已知零Token。",
      "collapsed": false,
      "panels": [],
      "gridPos": {
        "x": 0,
        "y": 43,
        "w": 24,
        "h": 1
      }
    },
    {
