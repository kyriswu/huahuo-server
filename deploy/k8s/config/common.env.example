# 复制到受限的测试环境配置目录。按当前测试环境的已审设置填写。
# 文件使用 kubectl --from-env-file 格式。值使用原文，行尾不要加注释。
APP_PUBLIC_BASE_URL=https://test.example.invalid
# 解析节点、Agent 等调用方可达的稳定 Server 入口。按现用地址与路由填写。
API_SERVICE_BASE_URL=https://test.example.invalid
REDIS_KEY_PREFIX=huahuo-test
DATABASE_SSL_MODE=verify-full
# 自定义 CA 通过 huahuo-db-ca ConfigMap 挂载。名称须与键名匹配。
# DATABASE_SSL_CA_FILE=/app/certs/ca.pem
STORAGE_DRIVER=aliyun-oss
STORAGE_ALIYUN_OSS_REGION=cn-beijing
STORAGE_ALIYUN_OSS_ENDPOINT=https://oss-cn-beijing-internal.aliyuncs.com
STORAGE_ALIYUN_OSS_PUBLIC_ENDPOINT=https://oss-cn-beijing.aliyuncs.com
STORAGE_ALIYUN_OSS_BUCKET=replace-with-test-bucket
STORAGE_ALIYUN_OSS_KEY_PREFIX=replace-with-test-prefix
LOG_LEVEL=info
BILLING_MODE=disabled
RAG_PROVIDER_MODE=disabled
ALLOW_MOCK_PROVIDERS=false
PROCESSING_NODES_CLOUD_CONTROL_ENABLED=false
# 启用现有 Agent 集成时填写稳定私网 origin，不带 /api 或 /agent 路径。
# HUAHUO_AGENT_BASE_URL=http://agent.test.internal
